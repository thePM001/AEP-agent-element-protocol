# AEP 2.9 Docker deploy - copy to .env and adjust
#   cp .env.example .env

UCB_PORT=8412
DATA_DOCK_PORT=8413
DATA_DOCK=1
# Data Dock binds loopback by default, even in Docker. To reach it on the
# published 8413 set DATA_DOCK_HOST=0.0.0.0. With DATA_DOCK_API_KEY empty the
# first boot mints $AEP_DATA/keys/data-dock.http-key with mode 0600. Read it with
# docker compose exec aep cat /data/aep/keys/data-dock.http-key
# A key set here wins over the file. Make one with: openssl rand -hex 32
DATA_DOCK_HOST=127.0.0.1
DATA_DOCK_API_KEY=
AEP_LATTICE_TRANSPORT=tls
AEP_LATTICE_TLS_BIND=0.0.0.0


# Generate with: openssl rand -hex 32

# UCB API key (recommended for production). Auto-generated on first boot if empty.
UCB_API_KEY=

# Universal Computation Module (AEP-Components/ucm). Off unless UCM=1. It binds loopback
# inside the container; to reach it on the published 8414 set UCM_HOST=0.0.0.0 and a key.
UCM=0
UCM_PORT=8414
UCM_HOST=127.0.0.1
UCM_API_KEY=
# Record each receipt digest in the Base Node lattice log.
UCM_LATTICE_RECORD=0
# Admit checks of computed fields: off, warn or strict. The trusted key file lists the
# hex public keys of UCM nodes, one per line (aep-ucm key prints the local one).
AEP_UCM_RECEIPT_PROFILE=off
AEP_UCM_TRUSTED_KEYS=

AEP_SETUP_LLM_PROVIDER=openrouter
AEP_SETUP_LLM_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=


# Public UCB compiles provided GAP text or JSON locally. It does not use a remote GAP engine URL.
# Interactive shell (debug only). Default off. Remote upgrades require ALLOW_REMOTE=1.
