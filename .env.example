# AEP 2.8.5 Docker deploy - copy to .env and adjust
#   cp .env.example .env

# Published ports (host:container is fixed at 8424/8412 inside the image)
COMPOSER_LITE_PORT=8424
UCB_PORT=8412

# Optional URL prefix when behind a reverse proxy (e.g. /lite)
COMPOSER_LITE_BASE_PATH=

# Default 127.0.0.1. For published bind set COMPOSER_LITE_HOST=0.0.0.0 and a strong token.
COMPOSER_LITE_HOST=127.0.0.1
# Generate with: openssl rand -hex 32
# DENY on miss: empty token + 0.0.0.0 refuses to start Composer Lite.
# Prefer header X-AEP-Setup-Token (or Authorization: Bearer) over query strings.
COMPOSER_LITE_SETUP_TOKEN=

# UCB API key (recommended for production). Auto-generated on first boot if empty.
UCB_API_KEY=

# Inference for setup agent / CCA (OpenRouter sample)
AEP_SETUP_LLM_PROVIDER=openrouter
AEP_SETUP_LLM_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=

# Set to 1 for non-interactive first-boot activation (optional)
AEP_AUTO_SETUP=0

# Public UCB compiles provided GAP text or JSON locally. It does not use a remote GAP engine URL.
# Interactive shell (debug only). Default off. Remote upgrades require ALLOW_REMOTE=1.
# COMPOSER_LITE_TERMINAL=0
# COMPOSER_LITE_TERMINAL_ALLOW_REMOTE=0
