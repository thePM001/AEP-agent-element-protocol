{
 "ucm": "ucm-vectors-v1",
 "suite": "money",
 "generator": "AEP-Components/ucm/scripts/gen_vectors.py",
 "cases": [
  {
   "id": "add-same",
   "program": "money(\"12.50\", \"CHF\") + money(\"0.75\", \"CHF\")",
   "expect": {
    "type": "money",
    "currency": "CHF",
    "value": "53/4",
    "decimal": "13.25"
   }
  },
  {
   "id": "add-mixed",
   "program": "money(\"1\", \"CHF\") + money(\"1\", \"EUR\")",
   "error": "type_error"
  },
  {
   "id": "mul-rational",
   "program": "money(\"10\", \"EUR\") * 1/3",
   "expect": {
    "type": "money",
    "currency": "EUR",
    "value": "10/3"
   }
  },
  {
   "id": "ratio",
   "program": "money(\"30\", \"USD\") / money(\"12\", \"USD\")",
   "expect": {
    "type": "rational",
    "value": "5/2",
    "decimal": "2.5"
   }
  },
  {
   "id": "round-half-even",
   "program": "round(money(\"2.345\", \"EUR\"), 2, \"half_even\")",
   "expect": {
    "type": "money",
    "currency": "EUR",
    "value": "117/50",
    "decimal": "2.34"
   }
  },
  {
   "id": "round-half-up",
   "program": "round(money(\"2.345\", \"EUR\"), 2, \"half_up\")",
   "expect": {
    "type": "money",
    "currency": "EUR",
    "value": "47/20",
    "decimal": "2.35"
   }
  },
  {
   "id": "convert",
   "program": "convert(money(100, \"USD\"), \"EUR\", 0.92)",
   "expect": {
    "type": "money",
    "currency": "EUR",
    "value": "92",
    "decimal": "92"
   }
  },
  {
   "id": "convert-bad-rate",
   "program": "convert(money(100, \"USD\"), \"EUR\", 0)",
   "error": "domain_error"
  },
  {
   "id": "bad-currency",
   "program": "money(1, \"usd\")",
   "error": "type_error"
  },
  {
   "id": "allocate-3",
   "program": "allocate(money(\"100.00\", \"USD\"), 3, 2)",
   "expect": {
    "type": "vector",
    "items": [
     {
      "type": "money",
      "currency": "USD",
      "value": "1667/50",
      "decimal": "33.34"
     },
     {
      "type": "money",
      "currency": "USD",
      "value": "3333/100",
      "decimal": "33.33"
     },
     {
      "type": "money",
      "currency": "USD",
      "value": "3333/100",
      "decimal": "33.33"
     }
    ]
   }
  },
  {
   "id": "allocate-weights",
   "program": "allocate(money(\"10.00\", \"EUR\"), [1, 1, 1, 1, 1, 1, 1], 2)",
   "expect": {
    "type": "vector",
    "items": [
     {
      "type": "money",
      "currency": "EUR",
      "value": "143/100",
      "decimal": "1.43"
     },
     {
      "type": "money",
      "currency": "EUR",
      "value": "143/100",
      "decimal": "1.43"
     },
     {
      "type": "money",
      "currency": "EUR",
      "value": "143/100",
      "decimal": "1.43"
     },
     {
      "type": "money",
      "currency": "EUR",
      "value": "143/100",
      "decimal": "1.43"
     },
     {
      "type": "money",
      "currency": "EUR",
      "value": "143/100",
      "decimal": "1.43"
     },
     {
      "type": "money",
      "currency": "EUR",
      "value": "143/100",
      "decimal": "1.43"
     },
     {
      "type": "money",
      "currency": "EUR",
      "value": "71/50",
      "decimal": "1.42"
     }
    ]
   }
  },
  {
   "id": "allocate-not-fit",
   "program": "allocate(money(\"10.005\", \"EUR\"), 2, 2)",
   "error": "domain_error"
  },
  {
   "id": "amount",
   "program": "amount(money(\"3.10\", \"EUR\"))",
   "expect": {
    "type": "rational",
    "value": "31/10",
    "decimal": "3.1"
   }
  },
  {
   "id": "currency",
   "program": "currency(money(1, \"JPY\"))",
   "expect": {
    "type": "text",
    "value": "JPY"
   }
  },
  {
   "id": "input-money",
   "program": "input p: money[USD];\np * 2",
   "inputs": {
    "p": "12.55 USD"
   },
   "expect": {
    "type": "money",
    "currency": "USD",
    "value": "251/10",
    "decimal": "25.1"
   }
  },
  {
   "id": "input-wrong-currency",
   "program": "input p: money[USD];\np * 2",
   "inputs": {
    "p": "12.55 EUR"
   },
   "error": "input_error"
  },
  {
   "id": "compare",
   "program": "money(\"5\", \"CHF\") < money(\"5.01\", \"CHF\")",
   "expect": {
    "type": "bool",
    "value": "true"
   }
  }
 ]
}
