@PAD: hvvcas-spec-v1
@GCDE: gaplune.policy.v1
schema_id: gaplune.hvvcas.v1
format: gaplune
crate: aep-named-surfaces
ticket: AEP28-ENV-057
note: Named surfaces execute so CodeSandbox runs agent code while policy transpilers emit GAP and MCP backend transport forwards allowed calls.

component:
  name: scan_code_sandbox_executes
  domain: lattice
  component_type: service
  intent: Scan CodeSandbox so agent code actually runs.
  input:
    name: src
    type: String
  output:
    name: scan
    type: String

component:
  name: scan_transpilers_emit_gap
  domain: lattice
  component_type: service
  intent: Scan Cedar and Rego transpilers so they emit GAP.
  input:
    name: src
    type: String
  output:
    name: scan
    type: String

component:
  name: scan_mcp_backend_transport
  domain: lattice
  component_type: service
  intent: Scan MCP backend transport so calls forward.
  input:
    name: src
    type: String
  output:
    name: scan
    type: String

component:
  name: scan_readme_names_surfaces
  domain: lattice
  component_type: service
  intent: Require READMEs to name live CodeSandbox transpilers and MCP transport.
  input:
    name: src
    type: String
  output:
    name: scan
    type: String

component:
  name: run_named_surface_gate
  domain: lattice
  component_type: service
  intent: Run every named surface scan on the live tree.
  input:
    name: src
    type: String
  output:
    name: scan
    type: String
