@PAD: hvvcas-spec-v1
@GCDE: gaplune.policy.v1
schema_id: gaplune.hvvcas.v1
format: gaplune
json: prohibited
crate: aep-live-entry
ticket: AEP28-ENV-036
note: Durable HVVCAS is GAPLUNE for crate aep-live-entry on ticket AEP28-ENV-036 so a template target_id is not a skip and every opened frame still runs collect-all Admit then Apply.

component:
  name: live_entry
  domain: envelope
  component_type: service
  intent: Rust live entry with in-process aep_envelope admit, YAML load, structural apply and ID mint, while a template target still meets Admit.
  input:
    name: event
    type: String
  output:
    name: result
    type: String
