flowchart TB
  subgraph BAND1[Ingress]
    direction LR
    subgraph SURFACES[Operator surfaces]
      direction TB
      CL[Composer Lite]
      CCA[CCA agent]
      HAR[Harness]
      WIZ[Installation Wizard]
    end
    subgraph BRIDGES[Bridges and clients]
      direction TB
      UCB[UCB airlock optional]
      CONN[AEP Connectors]
      SDK[SDK Clients]
    end
  end

  subgraph BAND2[Transport]
    LT[lattice-channels sealed PQEncryptedCapsule]
  end

  subgraph BAND3[Base Node kernel]
    direction LR
    DOCK[Docks open the frame]
    ADMIT[aep-envelope admit collect-all then Apply]
    MEET[aep-evaluation-chain 15-rule meet]
    REG[Registry]
  end

  CL --> LT
  CCA --> LT
  HAR --> LT
  WIZ --> LT
  UCB --> LT
  CONN --> LT
  SDK --> LT
  LT --> DOCK
  DOCK --> ADMIT
  DOCK --> MEET
  DOCK --> REG
