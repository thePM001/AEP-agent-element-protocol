# The gVisor pin of the CAW.
# One gVisor release, taken as the package of the gVisor apt pool. The package holds the
# program runsc and its helper programs under /usr/bin/gvisor-bin.
# A change of this file is one commit that reruns the whole caw-gvisor suite.
# The pin covers Linux on amd64. An arm64 pin is not proven yet.
RUNSC_VERSION=20261109.0
RUNSC_RELEASE=release-20261109.0
RUNSC_DEB_URL=https://storage.googleapis.com/gvisor/releases/pool/20261109.0/binary-amd64/runsc.deb
RUNSC_DEB_SHA256=44a1c843b12e47956fe3e5d9d1684ad83550b050c578a63e950197ffaef1619b
RUNSC_BIN=/usr/bin/runsc
RUNSC_BIN_SHA512=2de47d2924af9f5a6caa9155d9138f9b016a58e253e9097c796dd9b6116af8d613a9b06c8ab28d2660c891c84c8104ef81b2d70c8912552da30eebff013955e2
