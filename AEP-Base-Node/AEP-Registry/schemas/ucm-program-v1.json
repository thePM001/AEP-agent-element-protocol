{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aep.protocol.local/schemas/ucm-program-v1.json",
  "title": "AEP UCM Program v1",
  "description": "JSON form of a UCM-IR program. program_hash is SHA3-256 over the JSON Canonicalization Scheme (JCS) bytes of this object. The normative text is AEP-Components/ucm/spec/UCM-SPEC.md.",
  "type": "object",
  "required": [
    "ucm",
    "inputs",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "ucm": {
      "const": "ucm-program-v1"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "body": {
      "$ref": "#/definitions/expr"
    }
  },
  "definitions": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "int"
          ],
          "additionalProperties": false,
          "properties": {
            "int": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "dec"
          ],
          "additionalProperties": false,
          "properties": {
            "dec": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bool"
          ],
          "additionalProperties": false,
          "properties": {
            "bool": {
              "enum": [
                "true",
                "false"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "var"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "+",
                "-",
                "*",
                "/",
                "^",
                "neg",
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "and",
                "or",
                "not"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/definitions/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "call",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "call": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "if"
          ],
          "additionalProperties": false,
          "properties": {
            "if": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/definitions/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "let",
            "value",
            "in"
          ],
          "additionalProperties": false,
          "properties": {
            "let": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "value": {
              "$ref": "#/definitions/expr"
            },
            "in": {
              "$ref": "#/definitions/expr"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "lambda",
            "body"
          ],
          "additionalProperties": false,
          "properties": {
            "lambda": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            },
            "body": {
              "$ref": "#/definitions/expr"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "vec"
          ],
          "additionalProperties": false,
          "properties": {
            "vec": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "float"
          ],
          "additionalProperties": false,
          "properties": {
            "float": {
              "$ref": "#/definitions/expr"
            }
          }
        }
      ]
    }
  }
}
