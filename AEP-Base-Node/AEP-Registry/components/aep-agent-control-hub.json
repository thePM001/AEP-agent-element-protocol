{
  "manifest_version": "1",
  "id": "aep-agent-control-hub",
  "version": "2.8.6",
  "kind": "library",
  "path": "AEP-Base-Node/AEP-Agent-Control-Hub/",
  "description": "Kernel extension that binds GAP session, mount and agent-permission state.",
  "requires": [
    "aep-base-node"
  ],
  "capabilities": [
    "hub:session",
    "hub:mount",
    "hub:agent-permission"
  ],
  "actions": [],
  "setup_hooks": [],
  "resource_requirements": {
    "min_memory_mb": 16,
    "min_disk_mb": 5,
    "requires_internet": false,
    "gpu_required": false
  },
  "cca": {
    "summary": "Base Node kernel extension. Loads GAP profiles into session, mount and agent-permission state.",
    "use_when": [
      "every AEP deployment",
      "agent session control"
    ],
    "avoid_when": [],
    "pairs_with": [
      "aep-base-node",
      "gap"
    ]
  },
  "implementation": {
    "crate": "AEP-Base-Node/AEP-Agent-Control-Hub/crate"
  },
  "role": "kernel"
}
