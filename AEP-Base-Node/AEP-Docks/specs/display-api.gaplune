@PAD: gaplune.nla.dock-spec.v1
@GCDE: gaplune.policy.v1
schema_id: gaplune.nla.dock-spec.v1
format: gaplune
json: prohibited
port_id: display_api
name: display API dock
priority: 200
socket_suffix: /display
tls_port: 28429
purpose: JSON display dock with in-kernel pre-staging after Admit
transport: lattice-channel
implementation: AEP-Base-Node/AEP-Crate/src/dock_display.rs
crate_display_name: display-api-dock
known_views: view.alpha view.beta
known_sources: source.alpha source.beta
known_sectors: sector.one sector.two
actions: display-api:source:ingest display-api:sector:stage display-api:view:request display-api:view:project display-api:catalog:list
catalog: AEP-Components/display-api/lattice.yaml
grant_wall: AEP-Components/display-api/display-grants.gap
source_locator: each named source carries a locator that loads JSON into pre-staging at boot
http_adapter: json-body-requires-sealed-frame
ticket: DISPLAY-API-003
