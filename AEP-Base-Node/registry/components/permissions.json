{
  "manifest_version": "1",
  "id": "permissions",
  "version": "2.8.5",
  "kind": "library",
  "path": "AEP-Components/permissions/",
  "description": "Pointer to kernel agent permission. Checks live in the kernel permission wall.",
  "requires": [
    "policy-engine"
  ],
  "capabilities": [
    "permissions:check",
    "permissions:capability"
  ],
  "actions": [],
  "setup_hooks": [],
  "resource_requirements": {
    "min_memory_mb": 16,
    "min_disk_mb": 5,
    "requires_internet": false,
    "gpu_required": false
  },
  "cca": {
    "summary": "Pointer to kernel agent permission wall.",
    "use_when": [
      "capability-gated agents"
    ],
    "avoid_when": [],
    "pairs_with": []
  },
  "implementation": {
    "kernel": "AEP-Components/admit"
  },
  "role": "kernel"
}
